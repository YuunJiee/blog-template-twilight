# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All settings marked with (*) are also configurable in
# src/config/site.ts — env vars take priority.
# ──────────────────────────────────────────────────────────

# (*) Canonical URL of your deployed site (no trailing slash)
# Used in sitemap, RSS feed, and OG tags.
# If unset, falls back to the url field in src/config/site.ts
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Contact form (Resend) ──────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# Create an API key and paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The email address that will RECEIVE contact form submissions.
CONTACT_RECIPIENT_EMAIL=your@email.com

# The FROM address shown in received emails.
# Must match a domain you have verified in Resend.
# Format: "Display Name <email@yourdomain.com>"
CONTACT_FROM_EMAIL="My Blog <noreply@your-domain.com>"
